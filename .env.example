# Token do bot (Developer Portal → Bot → Token) - OBRIGATÓRIO
DISCORD_TOKEN=

# Application ID (Developer Portal > General Information > Application ID)
# Opcional: se não for informado, o bot infere automaticamente a partir do DISCORD_TOKEN
DISCORD_CLIENT_ID=

# Public Key (Developer Portal > General Information > Public Key) - Opcional para interações HTTP
DISCORD_PUBLIC_KEY=

# ID do servidor Discord (Opcional)
# Se DEIXAR VAZIO: os comandos slash serão registrados globalmente em TODOS os servidores onde o bot for adicionado,
# e o painel web detectará e listará automaticamente todos os servidores disponíveis!
# Se PREENCHIDO: foca o registro e visualização no servidor indicado.
DISCORD_GUILD_ID=

# Porta do servidor HTTP (Render define PORT automaticamente; padrão local: 3000)
PORT=3000

# MongoDB Atlas — usado para persistir agendamentos de canais, boatos, clima e IA
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/sete?retryWrites=true&w=majority

# Provedor de IA preferido: 'openrouter' ou 'gemini' (se não informado, usa OpenRouter se a chave existir, senão Gemini)
AI_PROVIDER=openrouter

# OpenRouter API Key (obtenha em https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modelo padrão do OpenRouter (exemplos de modelos de chat rápidos/gratuitos):
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemini-2.0-flash-exp:free
# - deepseek/deepseek-chat:free
# - nvidia/llama-3.1-nemotron-70b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini API Key (Google AI Studio) — Opcional / Fallback automático
GEMINI_API_KEY=

# Personalização opcional do bot
# BOT_NAME="Corvo de Três Olhos"
# BOT_NAME_SHORT="Corvo"
# BOT_EMOJI="🐦‍⬛"
# DEPLOY_GLOBAL=false

# Aviso: a UI em / não tem autenticação. Qualquer um com a URL
# pode ler e enviar mensagens (como o bot) nos canais acessíveis.
# No Developer Portal → Bot, ative Message Content Intent e Server Members Intent.

