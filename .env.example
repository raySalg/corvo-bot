# Token do bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=1517984369120378980

# ID do servidor para registrar comandos slash (opcional em dev; omita para comandos globais)
DISCORD_GUILD_ID=

# Porta do servidor HTTP (Render define PORT automaticamente)
PORT=3000

# MongoDB Atlas — cole SOMENTE a URL, sem aspas e sem "MONGODB_URI="
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/sete?retryWrites=true&w=majority

# OpenAI — usada para narrar os decretos no ciclo econômico (opcional)
# Gere/rotacione em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Opcionais:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_PROJECT=
