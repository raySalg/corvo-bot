# Token do bot (Developer Portal → Bot → Token)
DISCORD_TOKEN=

# Application ID (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=1517984369120378980

# Public Key (opcional — já embutida no código para o app Corvo)
DISCORD_PUBLIC_KEY=

# ID do servidor espelhado na UI (/) e para registrar comandos slash
DISCORD_GUILD_ID=1535764009515491458

# Porta do servidor HTTP (Render define PORT automaticamente)
PORT=3000

# MongoDB Atlas — usado para persistir o agendamento de exportação TXT
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/sete?retryWrites=true&w=majority

# Aviso: a UI em / não tem autenticação. Qualquer um com a URL do Render
# pode ler e enviar mensagens (como o bot) nos canais acessíveis.
# No Developer Portal → Bot, ative Message Content Intent e Server Members Intent.
